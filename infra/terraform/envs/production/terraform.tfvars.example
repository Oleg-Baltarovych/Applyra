# Copy to terraform.tfvars (gitignored) or export TF_VAR_<name>. Placeholders only — never commit real values.
# Secrets (hcloud_token, cloudflare_api_token, tailscale_auth_key) are better passed as TF_VAR_* env vars.

# hcloud_token          = "<hetzner-cloud-api-token>"
# cloudflare_api_token  = "<cloudflare-api-token>"
# tailscale_auth_key    = "<tskey-auth-single-use>"

deploy_ssh_public_key = "ssh-ed25519 AAAA<public-key> deploy@applyra"
cloudflare_account_id = "<cloudflare-account-id>"
cloudflare_zone_id    = "<cloudflare-zone-id>"
root_domain           = "example.com"

# server_type        = "cax21" # ARM; x86: "cx33"
# location           = "fsn1"
# volume_size_gb     = 20
# pages_project_name = "applyra"
