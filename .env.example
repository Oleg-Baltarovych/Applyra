# Applyra environment variables — the complete list (docs/spec/12-infra-ops.md §7).
#
# LOCAL DEVELOPMENT ONLY: `cp .env.example .env` and everything below works out of the box with
# `docker compose up -d`. Every value here is a public placeholder — never reuse one anywhere else.
# Real environments (R0 prod host; staging from R1) never use this file: their values live in
# GitHub Environment secrets and the deploy job renders /opt/applyra/.env (0600) on the host.
# `.env` is git-ignored; never commit it.
#
# Read by: docker compose (interpolation, from the repo root) and `pnpm --filter @applyra/api dev`
# (`node --env-file-if-exists`; an already-set process variable wins). `start` (production) reads the
# process env only. The api validates its variables with Zod at startup
# (apps/api/src/platform/config/env.schema.ts) and exits listing every invalid one. With
# NODE_ENV=production it also rejects any `local-dev-only` value and non-https auth URLs.

# ---------------------------------------------------------------------------------------------------
# Local infrastructure (compose.yaml → infra/compose/compose.yml). Required: compose fails without them.
# ---------------------------------------------------------------------------------------------------

# Postgres superuser (`postgres`); used only by the image's initdb and for admin work. Not used by apps.
POSTGRES_PASSWORD=local-dev-only-postgres-superuser-pw
# Role passwords for infra/postgres/init/10-roles.sql (≥ 16 chars, pairwise distinct).
# The init script runs ONLY on the first start with an empty volume — changing these later does not
# rotate the passwords (re-run the script by hand, see infra/postgres/README.md).
APPLYRA_APP_PASSWORD=local-dev-only-app-role-pw
APPLYRA_MAINTENANCE_PASSWORD=local-dev-only-maintenance-role-pw
APPLYRA_BACKUP_PASSWORD=local-dev-only-backup-role-pw
APPLYRA_METRICS_PASSWORD=local-dev-only-metrics-role-pw
# MinIO root credentials (S3 API :9000, console :9001); password ≥ 8 chars. Both must be URL-safe
# (no @ : / ? # %): compose passes them to mc as MC_HOST_* URLs to keep them off the command line.
MINIO_ROOT_USER=applyra-local
MINIO_ROOT_PASSWORD=local-dev-only-minio-root-pw

# Optional host ports (all published on 127.0.0.1 only). Defaults shown; change on a port clash and
# update the URLs below to match.
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# MINIO_API_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001
# MAILPIT_SMTP_HOST_PORT=1025
# MAILPIT_UI_HOST_PORT=8025

# ---------------------------------------------------------------------------------------------------
# API (apps/api) — validated by env.schema.ts; all required unless marked otherwise.
# ---------------------------------------------------------------------------------------------------

# development | test | production
NODE_ENV=development
# HTTP port of the api.
PORT=3000
# Reverse proxies in front of the api (trusted X-Forwarded-For hops → client IP for auth rate limits). 0 locally; 1 behind Caddy.
TRUST_PROXY_HOPS=0
# Runtime connection — role applyra_app (DML only). postgres:// or postgresql://.
DATABASE_URL=postgresql://applyra_app:local-dev-only-app-role-pw@localhost:5432/applyra
# Valkey (Redis protocol). redis:// or rediss://. Local Valkey has no password.
REDIS_URL=redis://localhost:6379
# Better Auth signing/encryption secret, ≥ 32 chars. Real environments: `openssl rand -base64 48`.
# Do NOT set BETTER_AUTH_SECRETS (rotation list): Better Auth would prefer it, so the api rejects it.
BETTER_AUTH_SECRET=local-dev-only-better-auth-secret-0123456789abcdef
# Public origin of the api, scheme://host[:port] without a path (OAuth callbacks, cookie scope).
BETTER_AUTH_URL=http://localhost:3000
# SPA origin, scheme://host[:port] without a path → Better Auth trustedOrigins (CORS allowlist from M0-09).
WEB_ORIGIN=http://localhost:5173
# Comma-separated emails allowed to sign up (FR-AUTH-02). Must be present; empty = sign-up closed.
AUTH_SIGNUP_ALLOWLIST=

# Optional integrations — the api starts without them (12 §7). Empty = unset.
# Google OAuth dev client (localhost). Set both or neither: one without the other is a startup error;
# the provider is registered only when both are set (M0-10).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Sentry DSN (http(s) URL); unset = Sentry off, the local default (12 §1).
# SENTRY_DSN=
# Ephemeral demo users (ADR 014; endpoint from M2-12). Strictly `true` or `false`; unset = false.
DEMO_ENABLED=true

# Not read by the api: Prisma CLI (apps/api/prisma.config.ts) and `pnpm db:migrate` / the one-off `migrate`
# job only — role applyra_maintenance (schema owner).
MAINTENANCE_DATABASE_URL=postgresql://applyra_maintenance:local-dev-only-maintenance-role-pw@localhost:5432/applyra
# Not read by the api: `pnpm db:migration <name>` and `prisma migrate diff` only. Needs a CREATEDB role
# (maintenance has none) → the local superuser; db:migration creates the database if missing. Never in prod.
SHADOW_DATABASE_URL=postgresql://postgres:local-dev-only-postgres-superuser-pw@localhost:5432/applyra_shadow

# Added by later tasks (not validated yet, leave unset until then):
# AI_MODE=stub                                   — live | stub | off; stub by default locally (07-ai.md §4)
# TURNSTILE_*                                    — required for DEMO_ENABLED in production (09 §11)
# S3_ENDPOINT=http://localhost:9000, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_BUCKET_DOCUMENTS=applyra-local-documents
#                                                — R1 documents/exports (MinIO buckets already created by compose)
# SMTP_HOST=localhost, SMTP_PORT=1025            — R1 notifications (Mailpit UI: http://localhost:8025)

# ---------------------------------------------------------------------------------------------------
# Web (apps/web) — public build-time values only: everything VITE_* ends up in the browser bundle.
# Never put a secret here. Wired in M0-12.
# ---------------------------------------------------------------------------------------------------

# Base URL of the REST API (10-frontend-ux.md: lib/api/client.ts).
VITE_API_URL=http://localhost:3000/api/v1
