{
  "name": "applyra",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.12",
  "engines": {
    "node": "^26.13.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @applyra/api db:migrate",
    "db:migration": "pnpm --filter @applyra/api db:migration"
  },
  "devDependencies": {
    "@applyra/config": "workspace:*",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "wrangler": "4.162.0"
  }
}
