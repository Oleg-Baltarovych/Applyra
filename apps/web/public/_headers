# SPA security headers (docs/spec/09-security-privacy.md §9.1) — Cloudflare Pages `_headers` syntax.
# Single source: infra/caddy/Caddyfile `(spa_headers)` must match (test/security-headers.test.ts).
# {$API_ORIGIN} is filled by scripts/headers.mjs renderHeaders() at deploy (dist/_headers) and by Caddy from its env.
# CSP `report-to` + Reporting-Endpoints arrive with Sentry web (R1).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' {$API_ORIGIN} https://*.ingest.de.sentry.io; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY
  Cache-Control: no-cache

# Hashed Vite assets: detach the /* Cache-Control first (Pages would join both values with a comma).
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
