{
  "name": "@applyra/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Applyra API: NestJS HTTP (src/main.ts) + BullMQ worker (src/worker.ts, from R1). Shared backend code lives only in src/platform/.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@applyra/contracts": "workspace:*",
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "~1.7.25",
    "express": "^5.2.1",
    "nestjs-zod": "^5.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@applyra/config": "workspace:*",
    "@nestjs/testing": "^11.2.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.15.0",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
}
